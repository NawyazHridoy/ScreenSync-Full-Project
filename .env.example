# ============================================================================
# ScreenSync — Public Client & Runtime Configuration (.env.example)
# ============================================================================
# Copy this file to .env for local tooling.
# NEVER commit a real .env file containing secret keys, service-role keys,
# database passwords, or Brevo SMTP passwords/API keys to version control.

# ----------------------------------------------------------------------------
# 1. Public Client-Safe Supabase Configuration (Safe for Browser & Mobile Clients)
#    Security is enforced by Supabase Auth and PostgreSQL Row Level Security (RLS).
# ----------------------------------------------------------------------------
SUPABASE_URL=https://ldephpgydnsovhlkuzbe.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_8mgpzcakPnNv8Z3g5lB_fg_86vpH-_q
VITE_SUPABASE_URL=https://ldephpgydnsovhlkuzbe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8mgpzcakPnNv8Z3g5lB_fg_86vpH-_q

# ----------------------------------------------------------------------------
# 2. Server-Side / Dashboard-Only Secrets (DO NOT EXPOSE IN CLIENT CODE)
#    Configure Brevo SMTP strictly inside Supabase Dashboard -> Authentication -> SMTP Settings:
#    - Host: smtp-relay.brevo.com
#    - Port: 587
#    - Sender email: nawyazahammedhridoy2003@gmail.com
#    - Sender name: ScreenSync
#    - Minimum interval per user: 60 seconds
#    - Email OTP Length: 6 digits
#    - Email OTP Expiration: 3600 seconds (1 hour)
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=NEVER_PLACE_IN_CLIENT_BUNDLE
# BREVO_SMTP_PASSWORD=CONFIGURED_IN_SUPABASE_DASHBOARD_ONLY

# ----------------------------------------------------------------------------
# 3. Local Desktop / Browser-Extension Bridge & Cross-Platform Thresholds
# ----------------------------------------------------------------------------
SCREENSYNC_ENV=production
SCREENSYNC_PORT=3000
SCREENSYNC_SYNC_PORT=39847
SCREENSYNC_DB_PATH=./screensync.db

# Cross-Platform Tracking Thresholds (DigitalWellbeingPC + ScreenSync)
SCREENSYNC_IDLE_THRESHOLD_SECONDS=300
SCREENSYNC_MAX_TICK_GAP_SECONDS=60
SCREENSYNC_CHECKPOINT_INTERVAL_MINUTES=5
SCREENSYNC_MIN_PERSISTED_SEGMENT_SECONDS=30
SCREENSYNC_JOIN_TOLERANCE_SECONDS=2
SCREENSYNC_WEBSITE_POLL_INTERVAL_SECONDS=7
SCREENSYNC_REEL_SETTLE_DEBOUNCE_MS=300
SCREENSYNC_REEL_MIN_DWELL_MS=1200
SCREENSYNC_SOUND_HARMFUL_DB_THRESHOLD=75.0
SCREENSYNC_SOUND_CONTINUOUS_EXPOSURE_SECONDS=1800
