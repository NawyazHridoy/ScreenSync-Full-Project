{
  "manifest_version": 3,
  "name": "ScreenSync Cross-Platform Web & Short-Form Companion",
  "version": "2.5.0",
  "description": "Privacy-preserving browser companion for ScreenSync on Windows, macOS, and ChromeOS. Classifies short-form video sessions in memory and persists only eTLD+1 hostnames.",
  "permissions": ["tabs", "idle", "storage"],
  "background": {
    "service_worker": "background_collector.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://*.snapchat.com/*"
      ],
      "js": ["content_shortform_observer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.screensync.app/*"
      ],
      "js": ["content_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
